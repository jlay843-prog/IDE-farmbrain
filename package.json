{
  "name": "forge-desk",
  "version": "1.3.6",
  "private": true,
  "description": "Local Qwen coding desk. Models stay on the farm LAN.",
  "author": "Jeff Lay",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desk": "electron .",
    "serve": "py -3 -m forge serve",
    "build:icon": "py -3 scripts/build-icon.py",
    "bundle:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-python.ps1",
    "vendor:monaco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vendor-monaco.ps1",
    "dist:win": "npm run bundle:python && npm run vendor:monaco && npm run build:icon && electron-builder --win nsis portable --x64",
    "smoke": "py -3 -m pytest tests/test_smoke.py -q && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-forge.ps1",
    "smoke:handoff": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-aether-handoff.ps1",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "smoke:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-all.ps1"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "farm.forge.desk",
    "productName": "Forge",
    "copyright": "Copyright © Jeff Lay",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src",
        "to": "src",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "ui",
        "to": "ui"
      },
      {
        "from": "pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "forge.cmd",
        "to": "forge.cmd"
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ui/forge.ico",
      "artifactName": "Forge-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "ui/forge.ico",
      "uninstallerIcon": "ui/forge.ico",
      "installerHeaderIcon": "ui/forge.ico",
      "uninstallDisplayName": "Forge",
      "artifactName": "Forge-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Forge-${version}.exe"
    },
    "forceCodeSigning": false,
    "npmRebuild": false
  }
}
